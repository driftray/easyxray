#!/usr/bin/env bash
# easyxray：用一个状态文件管理 Xray 服务器。不带参数运行进入菜单，easyxray help 查看命令
# SPDX-License-Identifier: GPL-3.0
set -o pipefail

EZ_HOME=${EZ_HOME:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)}
for f in common port protocol render users routing warp nginx system apply doctor update geo backup ui; do
    # shellcheck source=/dev/null
    source "${EZ_HOME}/lib/${f}.sh"
done
load_protocols

usage() {
    cat <<EOF
easyxray ${EZ_VERSION}：简单、安全的 Xray 服务器管理工具
用法：easyxray [命令]（不带命令进入菜单）

  install --domain 域名 [--full] [--protocols a,b] [--port-range 8000-8100] [--email 邮箱]
                                  首次安装。默认推荐安装（Reality-Vision + Hysteria2），--full 安装全部 5 个协议
  install --restore 备份文件      在新服务器上从备份恢复，沿用原来的用户、密钥和端口
  protocol list | enable 名称 [--port 端口] | disable 名称
  user list | add [邮箱] | del 邮箱  不填邮箱时生成 随机前缀@xray.fake
  sub [邮箱]                      显示订阅地址和分享链接
  route list | add 出口 规则 | del 出口 [规则] | quic block|allow | bt block|allow
                                  出口：direct、block、warp-ipv4；规则用逗号分隔，例如 anthropic,example.com,geoip:cn
                                  不带前缀的名称会去 geosite 列表里查（anthropic = geosite:anthropic）
  warp setup | remove             注册或删除 WARP 出口
  xray version | use [版本|latest] 查看或切换 Xray 版本（不填为推荐版本，latest 为最新正式版）
  update [版本]                   更新 easyxray 到最新发布版本（或指定版本），会校验 SHA256
  geo update | auto on|off        更新 geoip/geosite 数据 / 开关每周自动更新
  rekey [协议]                    重新生成密钥（不填为全部协议），客户端更新订阅后使用新密钥
  backup [文件]                   备份用户、密钥和设置（默认保存到 /root）
  log debug [分钟] | normal | show 临时打开调试日志（默认 30 分钟后自动恢复）
  apply | rollback | doctor       重新生成配置 / 恢复上一份配置 / 诊断
  uninstall [--keep-config | --purge]
                                  卸载。--keep-config 保留用户、端口、密钥和证书，之后重新安装即可恢复；
                                  --purge 删除全部配置、程序和证书；不带参数时询问

协议名称：reality-vision hysteria2 xhttp-tls reality-xhttp vless-tls-vision
EOF
}

need_installed() { state_exists || die "还没有安装，请先运行：easyxray install --domain 你的域名"; }

valid_protocol() {
    local p
    for p in "${EZ_PROTOCOLS[@]}"; do [[ "${p}" == "$1" ]] && return 0; done
    die "没有这个协议：$1（可选：${EZ_PROTOCOLS[*]}）"
}

# ---------- 安装 ----------

protocol_enable_state() {
    local p=$1 port=${2:-}
    [[ -n "${port}" ]] && proto_set "${p}" '{port: ($port|tonumber)}' --arg port "${port}"
    proto_call "${p}" init
    proto_set "${p}" '{enabled: true}'
}

link_commands() {
    no_system && return 0
    local name
    ln -sf "${EZ_HOME}/easyxray" /usr/local/bin/easyxray
    name=ezx
    if [[ -L "/usr/local/bin/${name}" && "$(readlink "/usr/local/bin/${name}")" == "${EZ_HOME}/easyxray" ]]; then
        return 0
    fi
    if command -v "${name}" >/dev/null 2>&1; then
        warn "系统里已经有 ${name} 命令（$(command -v "${name}")），不创建快捷命令，请用 easyxray"
    else
        ln -s "${EZ_HOME}/easyxray" "/usr/local/bin/${name}"
    fi
}

cmd_install() {
    local domain='' full='' protocols='' range='' email='' restore='' p
    while (($#)); do
        case "$1" in
        --domain) domain=$2; shift ;;
        --full) full=1 ;;
        --protocols) protocols=$2; shift ;;
        --port-range) range=$2; shift ;;
        --email) email=$2; shift ;;
        --restore) restore=$2; shift ;;
        --agree-tos) ;; # 兼容旧参数：安装时自动同意
        *) die "未知参数：$1" ;;
        esac
        shift
    done
    require_root
    if state_exists && [[ "$(state_get '.system.installed')" == "true" ]]; then
        die "已经安装过了（${EZ_STATE}）。修改设置请用其他命令，重新安装请先 uninstall"
    fi
    # 从备份恢复：先把备份里的配置放好，后面按「沿用已有配置」安装
    [[ -n "${restore}" ]] && restore_state "${restore}"
    # 保留配置卸载后重新安装时，域名可以不填
    [[ -z "${domain}" ]] && state_exists && domain=$(state_get .domain)
    [[ "${domain}" =~ ^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "请用 --domain 指定域名，例如 --domain box.example.com"
    check_os
    check_legacy
    info "证书由 Let's Encrypt 签发，安装即表示同意其服务条款：https://letsencrypt.org/repository/"
    if [[ -n "${full}" ]]; then
        protocols=$(IFS=,; echo "${EZ_PROTOCOLS[*]}")
    elif [[ -z "${protocols}" ]] && state_exists && [[ -n "$(enabled_protocols)" ]]; then
        # 已有配置时沿用原来开启的协议
        protocols=$(enabled_protocols | paste -sd, -)
    elif [[ -z "${protocols}" ]]; then
        protocols=$(IFS=,; echo "${EZ_PROTOCOLS_RECOMMENDED[*]}")
    fi
    [[ ",${protocols}," == *",reality-vision,"* ]] || die "Reality-Vision 必须安装（订阅和回落站点都依赖它）"
    IFS=, read -ra plist <<<"${protocols}"
    for p in "${plist[@]}"; do valid_protocol "${p}"; done

    install_packages
    ensure_service_user
    mkdir -p "${EZ_ETC}" "${EZ_XRAY_CONF}" "${EZ_TLS}" "${EZ_SUB}" "${EZ_LOG}" "${EZ_SNAPSHOTS}"
    # 上次安装没有完成时沿用已经生成的密钥、端口和用户
    if state_exists; then
        [[ "$(state_get .domain)" == "${domain}" ]] ||
            die "已有的配置用的是域名 $(state_get .domain)，请用同一个域名；要换域名请先运行 easyxray uninstall --purge 删除原来的配置"
        info "沿用已有的配置（域名 ${domain}）：用户、端口和密钥保持不变"
    else
        state_init "${domain}"
    fi
    [[ -n "${range}" ]] && state_update '.portRange = $r' --arg r "${range}"
    install_xray "${EZ_XRAY_RECOMMENDED}"

    # 先只开 80 端口申请证书
    install_site
    mkdir -p "$(dirname "${EZ_NGINX_CONF}")"
    render_nginx_conf >"${EZ_NGINX_CONF}"
    nginx_test || die "Nginx 配置有误，请检查 /etc/nginx 下是否有其他站点占用了 80 端口的同一域名"
    nginx_reload
    sync_firewall
    check_dns
    issue_cert

    enable_bbr
    install_logrotate
    install_service
    for p in "${plist[@]}"; do protocol_enable_state "${p}"; done
    if [[ "$(jq '.users | length' "${EZ_STATE}")" -eq 0 ]]; then
        email=$(user_add_state "${email}")
    else
        email=$(jq -r '.users[0].email' "${EZ_STATE}")
    fi
    link_commands
    [[ "$(jq -r '.system.geoAutoUpdate != false' "${EZ_STATE}")" == "true" ]] && geo_auto_on
    ez_apply || die "安装没有完成，请根据上面的提示处理后重新运行同样的安装命令"
    state_update '.system.installed = true'

    ok "安装完成"
    cmd_protocol_list
    warn "请在云服务商的安全组里放行：$(required_ports | sort -u | tr '\n' ' ')"
    cmd_sub "${email}"
}

# ---------- 协议 ----------

cmd_protocol_list() {
    local p state
    for p in "${EZ_PROTOCOLS[@]}"; do
        if protocol_enabled "${p}"; then
            state="${C_GREEN}已开启${C_RESET}  $(proto_call "${p}" transport | tr a-z A-Z) $(proto_get "${p}" .port)"
        else
            state="未开启"
        fi
        printf '  %-18s %s\n' "$(proto_call "${p}" title)" "${state}"
    done
}

cmd_protocol() {
    need_installed
    local action=${1:-list} p=${2:-} port=''
    [[ "${3:-}" == "--port" ]] && port=${4:-}
    case "${action}" in
    list) cmd_protocol_list ;;
    enable)
        valid_protocol "${p}"
        apply_change protocol_enable_state "${p}" "${port}" && ok "已开启 $(proto_call "${p}" title)，端口 $(proto_get "${p}" .port)"
        ;;
    disable)
        valid_protocol "${p}"
        [[ "${p}" == "reality-vision" ]] && die "Reality-Vision 不能关闭（订阅和回落站点都依赖它）"
        apply_change proto_set "${p}" '{enabled: false}' && ok "已关闭 $(proto_call "${p}" title)"
        ;;
    *) die "用法：easyxray protocol list | enable 名称 [--port 端口] | disable 名称" ;;
    esac
}

# ---------- 用户与订阅 ----------

cmd_user() {
    need_installed
    local action=${1:-list} email=${2:-}
    case "${action}" in
    list) user_list ;;
    add)
        # 先确定邮箱，这样 apply 之后能显示这个用户的订阅
        [[ -z "${email}" ]] && email=$(new_fake_email)
        apply_change user_add_state "${email}" >/dev/null || return 1
        ok "已添加用户：${email}"
        cmd_sub "${email}"
        ;;
    del)
        [[ -n "${email}" ]] || die "用法：easyxray user del 邮箱"
        apply_change user_del_state "${email}" && ok "已删除用户：${email}"
        ;;
    *) die "用法：easyxray user list | add [邮箱] | del 邮箱" ;;
    esac
}

cmd_sub() {
    need_installed
    local email=${1:-} uuid token url link
    [[ -n "${email}" ]] && ! user_exists "${email}" && die "没有这个用户：${email}"
    while IFS=$'\t' read -r email uuid token; do
        url="https://$(state_get .domain)/s/${token}"
        printf '\n'
        ui_top
        ui_title "${email}"
        ui_rule
        ui_row "订阅地址"
        ui_row "${C_GREEN}${url}${C_RESET}"
        ui_bottom
        command -v qrencode >/dev/null 2>&1 && qrencode -t ANSIUTF8 -m 2 "${url}"
        ui_top
        ui_row "单条分享链接（也可以单独复制导入）"
        ui_rule
        while read -r link; do
            ui_row "${C_CYAN}$(urldecode_name "${link}")${C_RESET}"
            ui_row "${C_DIM}${link}${C_RESET}"
            ui_blank
        done < <(user_links "${uuid}" "${email}")
        ui_bottom
    done < <(jq -r --arg e "${email}" '.users[] | select($e == "" or .email == $e) | [.email, .uuid, .subToken] | @tsv' "${EZ_STATE}")
    printf '\n'
    warn "Shadowrocket：请在 设置 → TCP 中选择支持 X25519MLKEM768 的较新 TLS 指纹，例如 chrome140、safari26_3"
    protocol_enabled hysteria2 && warn "Hysteria2：请在客户端里按自己宽带的实际速度填写上行/下行带宽"
    return 0
}

# ---------- 分流与 WARP ----------

cmd_route() {
    need_installed
    local action=${1:-list}
    case "${action}" in
    list) route_list ;;
    add)
        [[ -n "${2:-}" && -n "${3:-}" ]] || die "用法：easyxray route add 出口 规则（例如 route add warp-ipv4 anthropic,example.com）"
        apply_change route_add_state "$2" "$3" && ok "已添加分流规则"
        ;;
    del)
        [[ -n "${2:-}" ]] || die "用法：easyxray route del 出口 [规则]"
        apply_change route_del_state "$2" "${3:-}" && ok "已删除分流规则"
        ;;
    quic)
        case "${2:-}" in
        block) apply_change state_update '.routing.blockQUIC = true' && ok "已开启 QUIC 屏蔽" ;;
        allow) apply_change state_update '.routing.blockQUIC = false' && ok "已关闭 QUIC 屏蔽" ;;
        *) die "用法：easyxray route quic block|allow" ;;
        esac
        ;;
    bt)
        case "${2:-}" in
        block) apply_change state_update '.routing.blockBT = true' && ok "已开启 BT 屏蔽" ;;
        allow) apply_change state_update '.routing.blockBT = false' && ok "已关闭 BT 屏蔽" ;;
        *) die "用法：easyxray route bt block|allow" ;;
        esac
        ;;
    *) die "用法：easyxray route list | add 出口 规则 | del 出口 [规则] | quic block|allow | bt block|allow" ;;
    esac
}

cmd_warp() {
    need_installed
    case "${1:-}" in
    setup)
        [[ -n "$(state_get '.outbounds["warp-ipv4"].privateKey')" ]] && die "WARP 已经配置过了"
        apply_change warp_enable_state && ok "WARP 已开启，默认分流：${EZ_WARP_DEFAULT_RULES//,/、}"
        ;;
    remove) apply_change warp_remove_state warp-ipv4 && ok "已删除 WARP 出口和相关分流规则" ;;
    *) die "用法：easyxray warp setup | remove" ;;
    esac
}

# ---------- Xray 版本 ----------

cmd_xray() {
    need_installed
    case "${1:-version}" in
    version)
        local latest
        latest=$(latest_release XTLS/Xray-core)
        printf '当前：%s  推荐：%s  最新正式版：%s\n' "$(xray_installed_version)" "${EZ_XRAY_RECOMMENDED}" "${latest:+v${latest}}"
        ;;
    use)
        local version=${2:-${EZ_XRAY_RECOMMENDED}} prev
        require_root
        if [[ "${version}" == latest ]]; then
            version=$(latest_release XTLS/Xray-core)
            [[ -n "${version}" ]] || die "无法获取 Xray 最新版本，请检查服务器能否访问 github.com"
            version=v${version}
        fi
        [[ "${version}" == "${EZ_XRAY_RECOMMENDED}" ]] || warn "Xray ${version} 还没有经过 easyxray 测试，推荐版本是 ${EZ_XRAY_RECOMMENDED}"
        prev="${EZ_XRAY_BIN}.prev"
        cp -p "${EZ_XRAY_BIN}" "${prev}"
        install_xray "${version}"
        if apply_change state_update '.xray.version = $v' --arg v "${version}"; then
            rm -f "${prev}"
            ok "已切换到 Xray ${version}"
        else
            mv -f "${prev}" "${EZ_XRAY_BIN}"
            xray_restart
            die "新版本无法使用当前配置，已换回原来的版本"
        fi
        ;;
    *) die "用法：easyxray xray version | use [版本|latest]" ;;
    esac
}

# ---------- geo 数据 ----------

cmd_geo() {
    need_installed
    case "${1:-update}" in
    update) geo_update ;;
    auto)
        case "${2:-}" in
        on) geo_auto_on && state_update '.system.geoAutoUpdate = true' && ok "已开启每周自动更新 geo 数据" ;;
        off) geo_auto_off && state_update '.system.geoAutoUpdate = false' && ok "已关闭 geo 数据自动更新" ;;
        *) die "用法：easyxray geo auto on|off" ;;
        esac
        ;;
    *) die "用法：easyxray geo update | auto on|off" ;;
    esac
}

# ---------- 重新生成密钥 ----------

rekey_state() {
    local p
    for p in "$@"; do proto_rekey_state "${p}"; done
}

cmd_rekey() {
    need_installed
    local list=()
    if [[ -z "${1:-}" || "$1" == "all" ]]; then
        list=("${EZ_PROTOCOLS[@]}")
    else
        valid_protocol "$1"
        list=("$1")
    fi
    apply_change rekey_state "${list[@]}" || return 1
    ok "已重新生成密钥，旧的分享链接已经失效。请在客户端中更新订阅"
}

# ---------- 日志 ----------

cmd_log() {
    need_installed
    case "${1:-show}" in
    debug)
        local minutes=${2:-30}
        [[ "${minutes}" =~ ^[0-9]+$ ]] || die "分钟数不正确：${minutes}"
        apply_change state_update '.system.logLevel = "debug"' || return 1
        if ! no_system; then
            systemctl stop easyxray-log-reset.timer 2>/dev/null
            systemd-run --quiet --unit=easyxray-log-reset --on-active="${minutes}m" "${EZ_HOME}/easyxray" log normal
        fi
        ok "已打开调试日志，${minutes} 分钟后自动恢复。查看：tail -f ${EZ_LOG}/error.log ${EZ_LOG}/access.log"
        ;;
    normal) apply_change state_update '.system.logLevel = "warning"' && ok "日志已恢复为 warning，访问日志已关闭" ;;
    show) tail -n 50 "${EZ_LOG}/error.log" 2>/dev/null ;;
    *) die "用法：easyxray log debug [分钟] | normal | show" ;;
    esac
}

# ---------- 卸载 ----------

# 停止服务，删除 easyxray 写到系统里的配置：服务、Nginx 配置、防火墙规则、日志轮转、证书续期钩子
remove_system_files() {
    no_system && return 0
    systemctl disable --now easyxray >/dev/null 2>&1
    rm -f /etc/systemd/system/easyxray.service
    systemctl daemon-reload
    rm -f "${EZ_NGINX_CONF}" /etc/logrotate.d/easyxray /etc/letsencrypt/renewal-hooks/deploy/easyxray.sh
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
    remove_firewall_rules
    geo_auto_off
}

# 两种卸载：
#   --keep-config 保留 /etc/easyxray、证书和程序，之后重新安装沿用原来的用户、端口和密钥，客户端不用重新导入
#   --purge       另外删除 /etc/easyxray、程序、快捷命令、本域名的证书和 easyxray 用户
cmd_uninstall() {
    require_root
    local mode=${1:-} answer domain=''
    case "${mode}" in
    --keep-config) mode=keep ;;
    --purge) mode=purge ;;
    '')
        printf '1  保留配置卸载：停止服务，保留用户、端口、密钥和证书，之后重新安装即可恢复\n'
        printf '2  完全卸载：删除全部配置、程序和证书，客户端需要重新导入订阅\n'
        case "$(ui_ask "请选择（回车取消）：")" in
        1) mode=keep ;;
        2) mode=purge ;;
        *) die "已取消" ;;
        esac
        ;;
    *) die "用法：easyxray uninstall [--keep-config | --purge]" ;;
    esac
    if [[ "${mode}" == keep ]]; then
        read -r -p "确认卸载 easyxray？所有节点会停止工作，配置保留在 ${EZ_ETC} [y/N] " answer
    else
        read -r -p "确认完全卸载 easyxray？所有节点会停止工作，用户、密钥和证书会删除且无法恢复 [y/N] " answer
    fi
    [[ "${answer}" == "y" || "${answer}" == "Y" ]] || die "已取消"
    state_exists && domain=$(state_get .domain)
    remove_system_files

    if [[ "${mode}" == keep ]]; then
        state_exists && state_update '.system.installed = false'
        ok "已卸载，配置保留在 ${EZ_ETC}"
        ok "重新安装：运行 ezx 选择安装方式，或 ezx install，会沿用原来的用户、端口和密钥"
        return 0
    fi

    if ! no_system; then
        rm -f /usr/local/bin/easyxray
        [[ "$(readlink /usr/local/bin/ezx 2>/dev/null)" == "${EZ_HOME}/easyxray" ]] && rm -f /usr/local/bin/ezx
        if [[ -n "${domain}" && -d "/etc/letsencrypt/live/${domain}" ]]; then
            certbot delete --cert-name "${domain}" --non-interactive >/dev/null 2>&1 || warn "证书删除失败：${domain}"
        fi
        id "${EZ_USER}" >/dev/null 2>&1 && userdel "${EZ_USER}" 2>/dev/null
    fi
    rm -rf "${EZ_ETC}"
    # 程序目录：确认是 easyxray 的目录再删；测试模式下 EZ_HOME 是源码目录，不删
    if ! no_system && [[ "${EZ_HOME}" != "/" && -f "${EZ_HOME}/easyxray" && -f "${EZ_HOME}/lib/common.sh" ]]; then
        rm -rf "${EZ_HOME}"
    fi
    ok "已完全卸载。系统软件包（Nginx、certbot 等）和 BBR 设置保留"
}

# ---------- 菜单 ----------

menu_install() {
    local kept=''
    state_exists && kept=$(state_get .domain)
    ui_banner
    ui_rule
    if [[ -n "${kept}" ]]; then
        ui_row "检测到保留的配置：域名 ${kept}，$(jq '.users | length' "${EZ_STATE}") 个用户"
        ui_row "${C_DIM}重新安装会沿用原来的用户、端口和密钥，客户端不用重新导入${C_RESET}"
    else
        ui_row "${C_DIM}还没有安装，请选择安装方式：${C_RESET}"
    fi
    ui_rule
    if [[ -n "${kept}" ]]; then
        ui_menu 1 "恢复安装" "" ""
        ui_row "   ${C_DIM}沿用原来开启的协议${C_RESET}"
    else
        ui_menu 1 "推荐安装" "" ""
        ui_row "   ${C_DIM}Reality-Vision + Hysteria2，暴露的端口最少${C_RESET}"
    fi
    ui_menu 2 "完全安装" "" ""
    ui_row "   ${C_DIM}全部 5 个协议${C_RESET}"
    if [[ -z "${kept}" ]]; then
        ui_menu 3 "从备份恢复" "" ""
        ui_row "   ${C_DIM}沿用备份里的用户、密钥和端口，客户端不用重新导入${C_RESET}"
    fi
    ui_menu 0 "退出" "" ""
    ui_bottom
    local choice domain email
    choice=$(ui_ask "请选择：")
    case "${choice}" in
    1 | 2)
        if [[ -n "${kept}" ]]; then
            domain=${kept}
        else
            domain=$(ui_ask "域名（已解析到本机，例如 box.example.com）：")
            email=$(ui_ask "第一个用户的邮箱（直接回车自动生成）：")
        fi
        if [[ "${choice}" == "2" ]]; then
            (cmd_install --domain "${domain}" --full ${email:+--email "${email}"})
        else
            (cmd_install --domain "${domain}" ${email:+--email "${email}"})
        fi
        ui_pause
        ;;
    3)
        [[ -z "${kept}" ]] || return 1
        local file
        file=$(ui_ask "备份文件路径（例如 /root/easyxray-backup-20261027-120000.tar.gz）：")
        [[ -n "${file}" ]] && (cmd_install --restore "${file}")
        ui_pause
        ;;
    *) return 1 ;;
    esac
}

# 让用户从编号列表里选一项，输出选中的序号（从 0 开始）；回车或 0 返回空
pick_one() {
    local prompt=$1 count=$2 choice
    choice=$(ui_ask "${prompt}")
    [[ "${choice}" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= count)) || return 1
    printf '%s' $((choice - 1))
}

# 多选：输入 1,3 这样的编号，输出选中的序号；回车返回空
pick_many() {
    local prompt=$1 count=$2 choice n chosen=()
    choice=$(ui_ask "${prompt}")
    choice=${choice// /}
    [[ -n "${choice}" && "${choice}" != "0" ]] || return 1
    IFS=, read -ra list <<<"${choice}"
    for n in "${list[@]}"; do
        [[ "${n}" =~ ^[0-9]+$ ]] && ((n >= 1 && n <= count)) || { warn "编号不正确：${n}"; return 1; }
        chosen+=($((n - 1)))
    done
    printf '%s\n' "${chosen[@]}"
}

confirm() {
    [[ "$(ui_ask "$1（1 确认，回车取消）：")" == "1" ]]
}

menu_users() {
    local emails=() i idx
    mapfile -t emails < <(jq -r '.users[].email' "${EZ_STATE}")
    printf '\n'
    ui_top
    ui_title "用户管理"
    ui_rule
    for i in "${!emails[@]}"; do
        ui_row "${C_DIM}$(pad "$((i + 1))" 3)${C_RESET}${emails[$i]}"
    done
    ui_rule
    ui_menu 1 "添加用户" 2 "删除用户"
    ui_menu 3 "查看某个用户的订阅" 0 "返回"
    ui_bottom
    case "$(ui_ask "请选择：")" in
    1) (cmd_user add "$(ui_ask "邮箱（直接回车自动生成）：")") ;;
    2)
        idx=$(pick_one "删除第几个用户（回车返回）：" "${#emails[@]}") || return 0
        confirm "确认删除 ${emails[$idx]}" || return 0
        (cmd_user del "${emails[$idx]}")
        ;;
    3)
        idx=$(pick_one "查看第几个用户（回车返回）：" "${#emails[@]}") || return 0
        (cmd_sub "${emails[$idx]}")
        ;;
    *) return 0 ;;
    esac
    ui_pause
}

menu_protocols() {
    local p i=1 idx
    printf '\n'
    ui_top
    ui_title "协议管理"
    ui_rule
    for p in "${EZ_PROTOCOLS[@]}"; do
        if protocol_enabled "${p}"; then
            ui_row "${C_CYAN}${i}${C_RESET}  $(ui_status_dot on) $(pad "$(proto_call "${p}" title)" 20)$(proto_call "${p}" transport | tr '[:lower:]' '[:upper:]') $(proto_get "${p}" .port)"
        else
            ui_row "${C_CYAN}${i}${C_RESET}  $(ui_status_dot off) ${C_DIM}$(pad "$(proto_call "${p}" title)" 20)未开启${C_RESET}"
        fi
        i=$((i + 1))
    done
    ui_row "${C_CYAN}6${C_RESET}  重新生成所有协议的密钥"
    ui_row "${C_CYAN}0${C_RESET}  返回"
    ui_rule
    ui_row "${C_DIM}选择 1-5 切换开启/关闭；Reality-Vision 不能关闭${C_RESET}"
    ui_row "${C_DIM}怀疑分享链接泄露时可以重新生成密钥，客户端更新订阅即可${C_RESET}"
    ui_bottom
    idx=$(pick_one "请选择：" 6) || return 0
    if ((idx == 5)); then
        confirm "重新生成后旧的分享链接全部失效，所有客户端都要更新订阅，确认" || return 0
        (cmd_rekey)
        ui_pause
        return 0
    fi
    p=${EZ_PROTOCOLS[$idx]}
    if protocol_enabled "${p}"; then (cmd_protocol disable "${p}"); else (cmd_protocol enable "${p}"); fi
    ui_pause
}

# 某个出口的全部规则，每行一条
rules_of() {
    jq -r --arg o "$1" '.routing.rules[]? | select(.outbound == $o) | ((.domains // []) + (.ips // []))[]' "${EZ_STATE}"
}

rule_hint() {
    ui_row "${C_DIM}直接写名称即可（自动查 geosite 列表），例如 anthropic,openai,netflix${C_RESET}"
    ui_row "${C_DIM}也可以写域名 example.com、IP 段 1.2.3.0/24，或 geoip:cn${C_RESET}"
}

# 删除某个出口下选中的规则
delete_rules_of() {
    local out=$1 i idx
    local -a items=() picked=()
    mapfile -t items < <(rules_of "${out}")
    ((${#items[@]} > 0)) || { warn "没有可以删除的规则"; return 1; }
    printf '\n'
    for i in "${!items[@]}"; do ui_row "${C_CYAN}$((i + 1))${C_RESET}  ${items[$i]}"; done
    while read -r idx; do picked+=("${items[$idx]}"); done < <(pick_many "删除哪几条（例如 1 或 1,3；回车返回）：" "${#items[@]}")
    ((${#picked[@]} > 0)) || return 1
    (cmd_route del "${out}" "$(IFS=,; echo "${picked[*]}")")
}

menu_other_rules() {
    local out item n=0 items=() outs=() picked_direct=() picked_block=() idx choice target
    printf '\n'
    ui_top
    ui_title "直连 / 屏蔽规则"
    ui_rule
    for out in direct block; do
        while read -r item; do
            [[ -z "${item}" ]] && continue
            n=$((n + 1))
            items+=("${item}")
            outs+=("${out}")
            ui_row "${C_DIM}$(pad "${n}" 3)${C_RESET}$(pad "$([[ "${out}" == direct ]] && echo 直连 || echo 屏蔽)" 6)${item}"
        done < <(rules_of "${out}")
    done
    ((n == 0)) && ui_row "${C_DIM}还没有直连或屏蔽规则${C_RESET}"
    ui_rule
    ui_menu 1 "添加直连规则" 2 "添加屏蔽规则"
    ui_menu 3 "删除规则" 0 "返回"
    ui_bottom
    choice=$(ui_ask "请选择：")
    case "${choice}" in
    1 | 2)
        target=direct
        [[ "${choice}" == "2" ]] && target=block
        rule_hint
        item=$(ui_ask "规则（回车返回）：")
        [[ -n "${item// /}" ]] || return 0
        (cmd_route add "${target}" "${item}")
        ;;
    3)
        ((n > 0)) || { warn "没有可以删除的规则"; ui_pause; return 0; }
        while read -r idx; do
            if [[ "${outs[$idx]}" == direct ]]; then picked_direct+=("${items[$idx]}"); else picked_block+=("${items[$idx]}"); fi
        done < <(pick_many "删除哪几条（例如 1 或 1,3；回车返回）：" "${n}")
        ((${#picked_direct[@]} + ${#picked_block[@]} > 0)) || return 0
        ((${#picked_direct[@]} > 0)) && (cmd_route del direct "$(IFS=,; echo "${picked_direct[*]}")")
        ((${#picked_block[@]} > 0)) && (cmd_route del block "$(IFS=,; echo "${picked_block[*]}")")
        ;;
    *) return 0 ;;
    esac
    ui_pause
}

menu_routing() {
    local warp quic bt warp_rules=() i choice
    if [[ -n "$(state_get '.outbounds["warp-ipv4"].privateKey')" ]]; then warp=on; else warp=off; fi
    [[ "$(state_get '.routing.blockQUIC')" == "true" ]] && quic=on || quic=off
    bt_blocked && bt=on || bt=off
    mapfile -t warp_rules < <(rules_of warp-ipv4)
    printf '\n'
    ui_top
    ui_title "分流与屏蔽管理"
    ui_rule
    ui_row "$(ui_status_dot "${warp}") WARP $([[ "${warp}" == on ]] && echo 已开启 || echo 未开启)"
    if [[ "${warp}" == on ]]; then
        if ((${#warp_rules[@]} > 0)); then
            for i in "${!warp_rules[@]}"; do ui_row "   ${C_DIM}$(pad "$((i + 1))" 3)${C_RESET}${warp_rules[$i]}"; done
        else
            ui_row "   ${C_DIM}还没有 WARP 规则${C_RESET}"
        fi
    fi
    ui_rule
    if [[ "${warp}" == on ]]; then
        ui_menu 1 "关闭 WARP" 2 "添加 WARP 规则"
    else
        ui_menu 1 "开启 WARP" 2 "添加 WARP 规则"
    fi
    ui_menu 3 "删除 WARP 规则" 4 "直连 / 屏蔽规则"
    ui_menu 5 "QUIC 屏蔽：$([[ "${quic}" == on ]] && echo 开 || echo 关)" 6 "BT 屏蔽：$([[ "${bt}" == on ]] && echo 开 || echo 关)"
    ui_menu 0 "返回" "" ""
    [[ "${warp}" == off ]] && ui_row "${C_DIM}开启 WARP 时默认分流 ${EZ_WARP_DEFAULT_RULES//,/、}${C_RESET}"
    ui_row "${C_DIM}QUIC 屏蔽一般不需要开启，只在 QUIC 请求没有按规则分流时使用${C_RESET}"
    ui_bottom
    choice=$(ui_ask "请选择：")
    case "${choice}" in
    1)
        if [[ "${warp}" == on ]]; then
            confirm "关闭 WARP 会同时删除所有 WARP 规则，确认" || return 0
            (cmd_warp remove)
        else
            (cmd_warp setup)
        fi
        ;;
    2)
        [[ "${warp}" == on ]] || { warn "请先开启 WARP"; ui_pause; return 0; }
        rule_hint
        local items
        items=$(ui_ask "WARP 规则（回车返回）：")
        [[ -n "${items// /}" ]] || return 0
        (cmd_route add warp-ipv4 "${items}")
        ;;
    3) delete_rules_of warp-ipv4 || { ui_pause; return 0; } ;;
    4) menu_other_rules; return 0 ;;
    5) if [[ "${quic}" == on ]]; then (cmd_route quic allow); else (cmd_route quic block); fi ;;
    6) if [[ "${bt}" == on ]]; then (cmd_route bt allow); else (cmd_route bt block); fi ;;
    *) return 0 ;;
    esac
    ui_pause
}

