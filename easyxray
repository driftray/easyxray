menu() {
    local choice
    while :; do
        printf '\n'
        if ! state_exists || [[ "$(state_get '.system.installed')" != "true" ]]; then
            menu_install || return 0
            continue
        fi
        ui_dashboard
        ui_rule
        ui_menu 1 "查看订阅" 2 "用户管理"
        ui_menu 3 "协议管理" 4 "分流与屏蔽管理"
        ui_menu 5 "诊断" 6 "版本更新"
        ui_menu 7 "调试日志" 8 "备份与回滚"
        ui_menu 9 "卸载" 0 "退出"
        ui_bottom
        choice=$(ui_ask "请选择：")
        case "${choice}" in
        1) (cmd_sub); ui_pause ;;
        2) menu_users ;;
        3) menu_protocols ;;
        4) menu_routing ;;
        5) printf '\n'; (ez_doctor); ui_pause ;;
        6) menu_versions ;;
        7) (cmd_log debug "$(ui_ask "打开多少分钟（直接回车 30）：")"); ui_pause ;;
        8) menu_backup ;;
        9) (cmd_uninstall) && return 0 ;;
        0 | '') return 0 ;;
        esac
    done
}

main() {
    local cmd=${1:-menu}
    EZ_CMD=${*}
    shift || true
    # 状态文件里有密钥，权限是 600，除了 help 以外的命令都需要 root
    case "${cmd}" in
    help | -h | --help) ;;
    *) require_root ;;
    esac
    case "${cmd}" in
    install) cmd_install "$@" ;;
    protocol) cmd_protocol "$@" ;;
    user) cmd_user "$@" ;;
    sub) cmd_sub "$@" ;;
    route) cmd_route "$@" ;;
    warp) cmd_warp "$@" ;;
    xray) cmd_xray "$@" ;;
    log) cmd_log "$@" ;;
    update) ez_update "$@" ;;
    geo) cmd_geo "$@" ;;
    rekey) cmd_rekey "$@" ;;
    backup) need_installed; ez_backup "$@" ;;
    apply) require_root; need_installed; ez_apply && ok "配置已更新" ;;
    rollback) require_root; need_installed; ez_rollback ;;
    doctor) need_installed; ez_doctor ;;
    uninstall) cmd_uninstall "$@" ;;
    menu) require_root; menu ;;
    help | -h | --help) usage ;;
    *) usage; exit 1 ;;
    esac
}

main "$@"
