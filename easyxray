menu_backup() {
    printf '\n'
    ui_top
    ui_title "备份与回滚"
    ui_rule
    ui_menu 1 "恢复上一份配置" 2 "导出备份"
    ui_menu 0 "返回" "" ""
    ui_rule
    ui_row "${C_DIM}恢复上一份配置：撤销最近一次修改，最多可以连续撤销 5 次${C_RESET}"
    ui_row "${C_DIM}导出备份：换服务器时在新服务器上恢复，客户端不用重新导入${C_RESET}"
    ui_bottom
    case "$(ui_ask "请选择：")" in
    1) (ez_rollback) ;;
